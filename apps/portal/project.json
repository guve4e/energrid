{
  "name": "portal",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/portal/src",
  "projectType": "application",
  "targets": {
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "vite --config apps/portal/vite.config.ts --host 0.0.0.0"
      },
      "configurations": {
        "local": {
          "command": "PORTAL_API_PROXY_TARGET=http://localhost:3000 VITE_BACKEND_LABEL=local-live vite --config apps/portal/vite.config.ts --host 0.0.0.0"
        },
        "pi": {
          "command": "PORTAL_API_PROXY_TARGET=http://192.168.1.60:3000 VITE_BACKEND_LABEL=pi5-live vite --config apps/portal/vite.config.ts --host 0.0.0.0"
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/portal"],
      "options": {
        "command": "vite build --config apps/portal/vite.config.ts"
      }
    },
    "preview": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview --config apps/portal/vite.config.ts --host 0.0.0.0"
      }
    }
  }
}
