OPENAI_API_KEY=your_openai_key_here

HOME_MQTT_INGEST_ENABLED=true
HOME_MQTT_HOST=devicebroker.ddns.net
HOME_MQTT_PORT=1883
HOME_MQTT_TOPIC_PREFIX=energrid/tenant-demo/site-home
HOME_MQTT_DEBUG_TOPICS="energrid/tenant-demo/site-home/#,devices/#,shelly/#,$SYS/#"

VOICE_RUNS_ENABLED=true
VOICE_RUNS_FILE=data/voice-runs.jsonl

# Device Lab registration:
# discovery = telemetry creates unapproved discovered devices
# trusted   = publishes a retained trusted simulator inventory
DEVICE_LAB_REGISTRATION_MODE=discovery
DEVICE_LAB_GATEWAY_ID=device-lab-gateway
DEVICE_LAB_PUBLIC_BASE_URL=http://127.0.0.1:4100
# Optional measured weather verification. Keep credentials server-side.
# Enable only after checking the station's observed hourly metric coverage and interval timestamps.
# WEATHER_OBSERVATION_PROVIDER=meteostat
# WEATHER_OBSERVATION_COLLECTION_ENABLED=false
# METEOSTAT_GRANULARITY=daily
# METEOSTAT_STATION_ID=<verified five-character station ID>
# METEOSTAT_API_KEY=<RapidAPI key>
# METEOSTAT_INTERVAL_LABEL=<start or end, verified against the station feed>
# Daily native reports remain unscored until the station's reporting period is verified.
# METEOSTAT_DAILY_PERIOD_VERIFIED=false
# METEOSTAT_DAILY_TIMEZONE=Europe/Sofia
# METEOSTAT_DAILY_PERIOD_REFERENCE=<station operator evidence for midnight-to-midnight local reporting>
# Alternative: existing private weather-station adapter.
# WEATHER_OBSERVATION_SOURCE=<stable station identity>
# WEATHER_OBSERVATION_TOKEN=<dedicated private ingestion secret>
