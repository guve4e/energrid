OPENAI_API_KEY=your_openai_key_here

HOME_MQTT_INGEST_ENABLED=true
HOME_MQTT_HOST=devicebroker.ddns.net
HOME_MQTT_PORT=1883
HOME_MQTT_TOPIC_PREFIX=energrid/tenant-demo/site-home
HOME_MQTT_DEBUG_TOPICS="energrid/tenant-demo/site-home/#,devices/#,shelly/#,$SYS/#"

VOICE_RUNS_ENABLED=true
VOICE_RUNS_FILE=data/voice-runs.jsonl

# Device Lab registration:
# discovery = telemetry creates unapproved discovered devices
# trusted   = publishes a retained trusted simulator inventory
DEVICE_LAB_REGISTRATION_MODE=discovery
DEVICE_LAB_GATEWAY_ID=device-lab-gateway
DEVICE_LAB_PUBLIC_BASE_URL=http://127.0.0.1:4100
